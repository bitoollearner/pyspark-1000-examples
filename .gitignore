# ===========================================================================
#  .gitignore for the pyspark-1000-examples companion repo
# ===========================================================================

# --- Reader's local mount folder (seeded from the Docker image at runtime)
practice/

# --- Generated datasets (regenerable; see datasets/generate.py)
datasets/*.csv
datasets/raw/
datasets/formats/

# --- Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/

# --- Jupyter
.ipynb_checkpoints/

# --- Spark local state
metastore_db/
derby.log
spark-warehouse/
spark-events/

# --- Build artifacts and logs
*.log
build.log

# --- IDE and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Docker build cache
.docker-cache/